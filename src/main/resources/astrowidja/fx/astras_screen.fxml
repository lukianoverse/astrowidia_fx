<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="astrowidja.fx.AstrasController"
            fitToHeight="true" vbarPolicy="NEVER"
            style="-fx-background-color: #212121; -fx-background: #212121;">

    <!-- Горизонтальный контейнер для всех колонок. Сюда всё будет расти вправо -->
    <HBox fx:id="columnsContainer" spacing="20.0" style="-fx-background-color: #212121;">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- КОЛОНКА 1: Фиксированная (300px) под Основные 12 тел -->
        <VBox prefWidth="300.0" minWidth="300.0" maxWidth="300.0" spacing="10.0">
            <TitledPane text="ОСНОВНЫЕ ТЕЛА" collapsible="false" maxHeight="Infinity"
                        VBox.vgrow="ALWAYS"
                        style="-fx-base: #2b2b2b; -fx-text-fill: #888888; -fx-font-weight: bold;">
                <VBox fx:id="mainAstrasGroup" spacing="12.0" style="-fx-background-color: #2b2b2b;"/>
            </TitledPane>
        </VBox>

        <!-- КОЛОНКА 2: Фиксированная (300px) под Лунные факторы + Первый пакет расширения -->
        <VBox prefWidth="300.0" minWidth="300.0" maxWidth="300.0" spacing="15.0">

            <!-- Блок: Лунные точки -->
            <TitledPane text="ЛУННЫЕ ФАКТОРЫ" collapsible="false">
                <VBox fx:id="lunarAstrasGroup" spacing="10.0" style="-fx-background-color: #2b2b2b;"/>
            </TitledPane>

            <!-- Блок: Первый пакет расширения (Астероиды) -->
            <TitledPane text="РАСШИРЕННЫЕ АСТЕРОИДЫ" collapsible="false" maxHeight="Infinity"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="extraAsteroidsGroup" spacing="12.0" style="-fx-background-color: #2b2b2b;">
                    <!-- Сюда пойдут Эрида, Седна, Психея и др. -->
                </VBox>
            </TitledPane>
        </VBox>

        <!-- КОЛОНКИ ПОЛЬЗОВАТЕЛЯ БУДУТ ГЕНЕРИРОВАТЬСЯ ЗДЕСЬ ИЗ КОДА (вправо) -->

    </HBox>
</ScrollPane>