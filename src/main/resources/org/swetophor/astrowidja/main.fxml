<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="450.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.swetophor.astrowidja.fx.MainController">
<padding>
    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
</padding>
<HBox alignment="CENTER_LEFT" spacing="10.0">
    <Label fx:id="prompt" text="Выберите дату:" />
    <DatePicker fx:id="datePicker" />
    <Button fx:id="calculateButton" mnemonicParsing="false" onAction="#onCalculateClick" text="Рассчитать" />
</HBox>
<TextArea fx:id="resultTextArea" editable="false" prefHeight="310.0" prefWidth="420.0" style="-fx-font-family: 'Courier New';" VBox.vgrow="ALWAYS" />
</VBox>
